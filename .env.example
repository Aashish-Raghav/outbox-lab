# ─────────────────────────────────────────────────────────────────────────────
# ReachInbox Email Scheduler — environment
# Copy to `.env` at the repo root:  cp .env.example .env
# Every knob below is read through a zod schema (apps/api/src/config/env.ts),
# which fails fast on boot if anything is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── API server ───────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of browser origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://reachinbox:reachinbox@127.0.0.1:5432/reachinbox
# Used only by the integration test suite (it is TRUNCATEd between tests).
TEST_DATABASE_URL=postgresql://reachinbox:reachinbox@127.0.0.1:5432/reachinbox_test

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
# Redis must run with `appendonly yes` and `maxmemory-policy noeviction`,
# otherwise delayed jobs can be silently evicted or lost on restart.
REDIS_URL=redis://127.0.0.1:6379
# Namespaces all BullMQ keys; bump it to get a clean queue without FLUSHALL.
QUEUE_PREFIX=reachinbox

# ── Worker: concurrency & throughput ─────────────────────────────────────────
# How many jobs a single worker process handles in parallel.
WORKER_CONCURRENCY=5
# Minimum gap between two individual email sends, enforced by BullMQ's
# Redis-backed limiter, so it holds across every worker process, not per-process.
# Default 2000ms  =>  "minimum 2 seconds between sends".
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Retry policy for transient SMTP failures (exponential backoff).
MAX_ATTEMPTS=3
RETRY_BACKOFF_MS=5000

# ── Rate limiting (hourly quotas) ────────────────────────────────────────────
# Enforced by an atomic Redis Lua script keyed by hour window, so the counters
# are correct across any number of worker instances.
# Global ceiling across every sender.
MAX_EMAILS_PER_HOUR=200
# Default per-sender ceiling. A Sender row may override this via its
# `maxEmailsPerHour` column; a campaign may request a lower value still.
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# A job bumped into the next hour window this many times is marked FAILED
# rather than ping-ponging forever.
MAX_RESCHEDULES=48
# Quota is reserved *before* the send and, by default, never refunded — so a
# provider's real limit can never be exceeded. Set true to refund on failure.
RATE_LIMIT_REFUND_ON_FAILURE=false
# If true, a job whose assigned sender is capped may be re-routed to another
# sender that still has quota, instead of waiting for the next window.
SENDER_FAILOVER=false

# ── Restart recovery ─────────────────────────────────────────────────────────
# A row stuck in PROCESSING longer than this is considered abandoned.
STALE_LOCK_MS=300000
# Re-send a job whose outcome is indeterminate (crashed after SMTP accepted it
# but before the DB commit)? Default false: prefer a missed send over a double
# send. See docs/ARCHITECTURE.md.
RESEND_SUSPECT_JOBS=false
# Secondary self-healing sweep that re-runs the boot reconciler. This is NOT the
# scheduling mechanism (BullMQ delayed jobs are) and uses no cron library.
# Set to 0 to disable entirely — scheduling still works, and a test proves it.
RECONCILE_INTERVAL_MS=300000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Real Google OAuth. Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials with
#   Authorized JavaScript origins: http://localhost:3000
# Only the Client ID is needed — we use the Google Identity Services ID-token
# flow and verify the token server-side, so there is no client secret to leak.
GOOGLE_CLIENT_ID=
# Secret used to sign our own session JWT. MUST be changed outside development.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRES_IN=7d
# Demo escape hatch so the dashboard is reviewable without Google credentials.
# Enables the email/password form shown in the Figma. Refused when NODE_ENV=production.
ALLOW_PASSWORD_LOGIN=true
DEMO_USER_EMAIL=demo@reachinbox.ai
DEMO_USER_PASSWORD=demo1234

# ── Email / SMTP (Ethereal) ──────────────────────────────────────────────────
# Senders live in the `senders` table. Provision real Ethereal inboxes with:
#   npm run provision:ethereal -- --count 3
# That script calls Ethereal's API, creates real throwaway SMTP accounts and
# seeds them, so no SMTP credentials need to live in this file.
ETHEREAL_SENDER_COUNT=3
# Cap on a single uploaded lead list / attachment.
MAX_UPLOAD_BYTES=5242880
MAX_RECIPIENTS_PER_CAMPAIGN=5000
UPLOAD_DIR=./uploads

# ── Frontend (apps/web) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
